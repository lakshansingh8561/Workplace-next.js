// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum PaymentType {
  HOURLY
  FIXED
}

enum ExperienceLevel {
  ENTRY
  INTERMEDIATE
  EXPERT
}

enum JobStatus {
  DRAFT
  OPEN
  PAUSED
  IN_PROGRESS
  COMPLETED
  CLOSED
}

model Job {
  id                    String          @id @default(auto()) @map("_id") @db.ObjectId
  title                 String
  description           String
  category              String
  skills                String[]
  type                  PaymentType     @default(FIXED)
  budget                Float?
  hourlyMin             Float?
  hourlyMax             Float?
  duration              String?
  experienceLevel       ExperienceLevel @default(INTERMEDIATE)
  status                JobStatus       @default(OPEN)
  proposalsCount        Int             @default(0)

  // Ownership
  clientId              String?         @db.ObjectId
  client                User?           @relation(fields: [clientId], references: [id])

  proposals             Proposal[]
  contract              Contract?
  savedBy               SavedJob[]

  // Client Snapshot
  clientName            String?
  clientCountry         String?
  clientRating          Float?          @default(5.0)
  clientSpent           Float?          @default(0)
  clientPaymentVerified Boolean         @default(true)

  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@index([clientId])
  @@index([category])
  @@index([status])
  @@index([type])
  @@index([experienceLevel])
  @@index([createdAt])
  @@map("jobs")
}

enum Role {
  CLIENT
  FREELANCER
}

enum ProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum ContractStatus {
  ACTIVE
  PAUSED
  COMPLETED
  TERMINATED
}

enum MilestoneStatus {
  PENDING
  ACTIVE
  SUBMITTED
  APPROVED
}

model User {
  id                  String     @id @default(auto()) @map("_id") @db.ObjectId
  name                String?
  email               String     @unique
  emailVerified       DateTime?
  image               String?
  passwordHash        String?
  role                Role       @default(CLIENT)
  roleSelected        Boolean    @default(true)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  // Shared Profile Fields
  location            String?

  // Freelancer Profile Fields
  title               String?
  bio                 String?
  skills              String[]   @default([])
  hourlyRate          Float?
  experience          String?
  languages           String[]   @default([])
  portfolioUrls       String[]   @default([])

  // Client Profile Fields
  companyName         String?
  companyDescription  String?
  companyWebsite      String?
  companyIndustry     String?

  accounts            Account[]
  sessions            Session[]
  jobs                Job[]
  proposals           Proposal[]
  savedJobs           SavedJob[]
  clientContracts     Contract[] @relation("ClientContracts")
  freelancerContracts Contract[] @relation("FreelancerContracts")
  clientConversations Conversation[] @relation("ClientConversations")
  freelancerConversations Conversation[] @relation("FreelancerConversations")
  sentMessages        Message[]  @relation("SentMessages")
  notifications       Notification[] @relation("UserNotifications")
  reviewsGiven        Review[]       @relation("ReviewsGiven")
  reviewsReceived     Review[]       @relation("ReviewsReceived")
  timeEntries         TimeEntry[]    @relation("FreelancerTimeEntries")
  paymentsMade        Payment[]      @relation("PaymentsMade")
  paymentsReceived    Payment[]      @relation("PaymentsReceived")

  @@map("users")
}

model Proposal {
  id                String         @id @default(auto()) @map("_id") @db.ObjectId
  jobId             String         @db.ObjectId
  job               Job            @relation(fields: [jobId], references: [id])
  freelancerId      String         @db.ObjectId
  freelancer        User           @relation(fields: [freelancerId], references: [id])
  coverLetter       String
  bidAmount         Float
  estimatedDuration String?
  status            ProposalStatus @default(PENDING)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  contract          Contract?

  @@unique([jobId, freelancerId])
  @@index([jobId])
  @@index([freelancerId])
  @@index([status])
  @@index([freelancerId, status])
  @@map("proposals")
}

model Contract {
  id                String              @id @default(auto()) @map("_id") @db.ObjectId
  proposalId        String              @unique @db.ObjectId
  proposal          Proposal            @relation(fields: [proposalId], references: [id])
  jobId             String              @unique @db.ObjectId
  job               Job                 @relation(fields: [jobId], references: [id])
  clientId          String              @db.ObjectId
  client            User                @relation("ClientContracts", fields: [clientId], references: [id])
  freelancerId      String              @db.ObjectId
  freelancer        User                @relation("FreelancerContracts", fields: [freelancerId], references: [id])

  title             String
  type              PaymentType         @default(FIXED)
  totalAmount       Float?
  hourlyRate        Float?
  terms             String?
  status            ContractStatus      @default(ACTIVE)

  startDate         DateTime            @default(now())
  endDate           DateTime?

  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  milestones        ContractMilestone[]
  conversation      Conversation?
  reviews           Review[]
  timeEntries       TimeEntry[]
  timeScreenshots   TimeScreenshot[]
  payments          Payment[]

  @@index([clientId])
  @@index([freelancerId])
  @@index([status])
  @@map("contracts")
}

model ContractMilestone {
  id          String          @id @default(auto()) @map("_id") @db.ObjectId
  contractId  String          @db.ObjectId
  contract    Contract        @relation(fields: [contractId], references: [id], onDelete: Cascade)
  title       String
  description String?
  amount      Float
  dueDate     DateTime?
  status      MilestoneStatus @default(PENDING)
  isPaid      Boolean         @default(false)
  paidAt      DateTime?
  payments    Payment[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([contractId])
  @@index([status])
  @@map("contract_milestones")
}

model Conversation {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  contractId   String    @unique @db.ObjectId
  contract     Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  clientId     String    @db.ObjectId
  client       User      @relation("ClientConversations", fields: [clientId], references: [id])
  freelancerId String    @db.ObjectId
  freelancer   User      @relation("FreelancerConversations", fields: [freelancerId], references: [id])

  messages      Message[]
  lastMessageAt DateTime  @default(now())

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([clientId])
  @@index([freelancerId])
  @@index([lastMessageAt])
  @@map("conversations")
}

model Message {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  conversationId String       @db.ObjectId
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String       @db.ObjectId
  sender         User         @relation("SentMessages", fields: [senderId], references: [id])
  content        String
  read           Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@map("messages")
}

enum NotificationType {
  NEW_MESSAGE
  MILESTONE_SUBMITTED
  MILESTONE_APPROVED
  CONTRACT_STATUS
}

model Notification {
  id        String           @id @default(auto()) @map("_id") @db.ObjectId
  userId    String           @db.ObjectId
  user      User             @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType @default(NEW_MESSAGE)
  title     String
  message   String
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, read])
  @@index([userId, createdAt])
  @@map("notifications")
}

model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.String
  access_token      String? @db.String
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.String
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model SavedJob {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId     String   @db.ObjectId
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, jobId])
  @@index([userId])
  @@index([jobId])
  @@index([createdAt])
  @@map("saved_jobs")
}

model Review {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  contractId String   @db.ObjectId
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  reviewerId String   @db.ObjectId
  reviewer   User     @relation("ReviewsGiven", fields: [reviewerId], references: [id], onDelete: Cascade)
  revieweeId String   @db.ObjectId
  reviewee   User     @relation("ReviewsReceived", fields: [revieweeId], references: [id], onDelete: Cascade)
  rating     Int
  feedback   String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([contractId, reviewerId])
  @@index([revieweeId])
  @@index([reviewerId])
  @@index([contractId])
  @@map("reviews")
}

enum TimeTrackingStatus {
  RECORDING
  PAUSED
  STOPPED
}

enum TimesheetReviewStatus {
  DRAFT
  SUBMITTED
  APPROVED
  DISPUTED
}

model TimeEntry {
  id                 String                @id @default(auto()) @map("_id") @db.ObjectId
  contractId         String                @db.ObjectId
  contract           Contract              @relation(fields: [contractId], references: [id], onDelete: Cascade)
  freelancerId       String                @db.ObjectId
  freelancer         User                  @relation("FreelancerTimeEntries", fields: [freelancerId], references: [id], onDelete: Cascade)

  description        String?
  status             TimeTrackingStatus    @default(RECORDING)

  startTime          DateTime              @default(now())
  endTime            DateTime?
  pausedAt           DateTime?

  durationSeconds    Int                   @default(0)
  totalPausedSeconds Int                   @default(0)

  hourlyRate         Float
  billableAmount     Float?

  reviewStatus       TimesheetReviewStatus @default(DRAFT)
  submittedAt        DateTime?
  reviewedAt         DateTime?
  reviewedById       String?               @db.ObjectId
  disputeReason      String?
  isPaid             Boolean               @default(false)
  paidAt             DateTime?

  screenshots        TimeScreenshot[]

  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@index([contractId, startTime])
  @@index([contractId, reviewStatus])
  @@index([freelancerId, status])
  @@index([contractId, status])
  @@map("time_entries")
}

model TimeScreenshot {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  timeEntryId   String    @db.ObjectId
  timeEntry     TimeEntry @relation(fields: [timeEntryId], references: [id], onDelete: Cascade)
  contractId    String    @db.ObjectId
  contract      Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)

  timestamp     DateTime  @default(now())
  imageUrl      String?

  activityScore Float     @default(100.0)
  keystrokes    Int       @default(0)
  mouseEvents   Int       @default(0)
  memo          String?

  createdAt     DateTime  @default(now())

  @@index([timeEntryId, timestamp])
  @@index([contractId, timestamp])
  @@map("time_screenshots")
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum PaymentItemType {
  MILESTONE
  HOURLY_TIMESHEET
}

model Payment {
  id                String             @id @default(auto()) @map("_id") @db.ObjectId
  contractId        String             @db.ObjectId
  contract          Contract           @relation(fields: [contractId], references: [id], onDelete: Cascade)
  payerId           String             @db.ObjectId
  payer             User               @relation("PaymentsMade", fields: [payerId], references: [id])
  recipientId       String             @db.ObjectId
  recipient         User               @relation("PaymentsReceived", fields: [recipientId], references: [id])

  itemType          PaymentItemType
  milestoneId       String?            @db.ObjectId
  milestone         ContractMilestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  timeEntryIds      String[]

  amount            Float
  currency          String             @default("USD")
  amountSubunits    Int

  razorpayOrderId   String             @unique
  razorpayPaymentId String?            @unique
  razorpaySignature String?

  status            PaymentStatus      @default(PENDING)
  failureReason     String?
  paidAt            DateTime?

  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([contractId])
  @@index([payerId])
  @@index([recipientId])
  @@index([milestoneId])
  @@index([status])
  @@map("payments")
}

